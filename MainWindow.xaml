                </Button></Grid>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Popup>
            <!-- Slider de volume horizontal estilo Windows 11 Fluent Flyout -->
            <Popup x:Name="VolumePopup" PlacementTarget="{Binding ElementName=VolumeButton}"
                   Placement="Top" AllowsTransparency="True" PopupAnimation="{DynamicResource FlyoutAnimation}" StaysOpen="True"
                   Closed="VolumePopup_Closed">
                <Border x:Name="VolumePopupBorder" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="12,9" Margin="8"
                        BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                        MouseLeave="VolumePopup_MouseLeave" MouseWheel="Volume_MouseWheel">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
                    </Border.Effect>
                    <StackPanel Orientation="Horizontal">
                        <Path x:Name="VolumePopupIcon" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource SecondaryBrush}"
