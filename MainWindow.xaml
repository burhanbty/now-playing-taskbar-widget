<Window x:Class="SpotifyTaskbarWidget.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
        Title="Spotify Widget"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ShowInTaskbar="False" ShowActivated="False"
        ResizeMode="NoResize" SizeToContent="WidthAndHeight"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        FontFamily="Segoe UI Variable Text, Segoe UI">

    <Window.Resources>
      <ResourceDictionary>
        <ResourceDictionary.MergedDictionaries>
            <ResourceDictionary Source="Themes/Dark.xaml"/>
        </ResourceDictionary.MergedDictionaries>
        <primitives:PopupAnimation x:Key="FlyoutAnimation">Fade</primitives:PopupAnimation>

        <!-- Only opacity animates: hit targets and responsive measurements stay fixed. -->
        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Width" Value="26"/>
            <Setter Property="Height" Value="26"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border x:Name="feedback" CornerRadius="13" Background="{DynamicResource ControlFeedbackBrush}" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Primary transport action, with the same compact 30 DIP footprint. -->
        <Style x:Key="PlayButton" TargetType="Button">
            <Setter Property="AutomationProperties.Name" Value="{Binding ToolTip, RelativeSource={RelativeSource Self}}"/>
            <Setter Property="Background" Value="{DynamicResource GlassPlayBrush}"/>
            <Setter Property="Width" Value="30"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualStateGroup.Transitions>
                                        <VisualTransition GeneratedDuration="0:0:0.14"/>
                                    </VisualStateGroup.Transitions>
                                    <VisualState x:Name="Normal">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="1" Duration="0"/></Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Disabled">
                                        <Storyboard><DoubleAnimation Storyboard.TargetName="feedback" Storyboard.TargetProperty="Opacity" To="0" Duration="0"/></Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Border Background="{TemplateBinding Background}" CornerRadius="20"/>
                            <Border x:Name="feedback" Background="{DynamicResource PlayFeedbackBrush}" CornerRadius="20" Opacity="0"/>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Menu de contexto estilo Windows 11 Fluent: cantos arredondados, sombra difusa e destaque suave -->
        <Style TargetType="ContextMenu">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Margin="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4,5"
                                BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
                            </Border.Effect>
                            <StackPanel IsItemsHost="True"
                                        KeyboardNavigation.DirectionalNavigation="Cycle"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
            <Setter Property="FontFamily" Value="Segoe UI Variable Text, Segoe UI"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Border x:Name="bg" CornerRadius="5" Background="Transparent" Padding="10,6" Margin="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="22"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="14"/>
                                </Grid.ColumnDefinitions>
                                <Path x:Name="check" Grid.Column="0" Data="M1.5,6 L5,9.5 L12,2"
                                      Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                      Width="12" Height="11" Stretch="Uniform"
                                      VerticalAlignment="Center" Visibility="Hidden"/>
                                <ContentPresenter Grid.Column="1" ContentSource="Header"
                                                  VerticalAlignment="Center" RecognizesAccessKey="True"/>
                                <Path x:Name="arrow" Grid.Column="2" Data="M1,1 L5,5 L1,9"
                                      Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.5" StrokeStartLineCap="Round"
                                      StrokeEndLineCap="Round"
                                      VerticalAlignment="Center" HorizontalAlignment="Right"
                                      Visibility="Collapsed"/>
                                <Popup x:Name="PART_Popup" Placement="Right" HorizontalOffset="-4"
                                       VerticalOffset="-6" IsOpen="{TemplateBinding IsSubmenuOpen}"
                                       AllowsTransparency="True" Focusable="False" PopupAnimation="{DynamicResource FlyoutAnimation}">
                                    <Border Margin="10" Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Padding="4,5"
                                            BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="22" ShadowDepth="4" Direction="270" Opacity="0.45" Color="#000000"/>
                                        </Border.Effect>
                                        <StackPanel IsItemsHost="True"
                                                    KeyboardNavigation.DirectionalNavigation="Cycle"/>
                                    </Border>
                                </Popup>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ControlFeedbackBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSubmenuOpen" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource ControlFeedbackBrush}"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="check" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="Role" Value="SubmenuHeader">
                                <Setter TargetName="arrow" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource DisabledBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="Separator">
            <Setter Property="OverridesDefaultStyle" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Rectangle Height="1" Fill="{DynamicResource SeparatorBrush}" Margin="6,4"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Slider estilo Windows 11 Fluent: trilha suave, preenchimento verde, thumb refinado -->
        <Style x:Key="SpotifySlider" TargetType="Slider">
            <Setter Property="Height" Value="16"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource SliderTrackBrush}"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Focusable="False" Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" CornerRadius="2" Background="{DynamicResource AccentBrush}"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton IsTabStop="False" Focusable="False" Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Height="4" Background="Transparent"/>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12" Focusable="False">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="{DynamicResource SliderThumbBrush}" Stroke="{DynamicResource SurfaceBorderBrush}" StrokeThickness="1" Width="12" Height="12">
                                                    <Ellipse.Effect>
                                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.25" Color="#000000"/>
                                                    </Ellipse.Effect>
                                                </Ellipse>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
      </ResourceDictionary>
    </Window.Resources>

    <!-- Fundo quase transparente (#01000000) para o rato ser detetado (menu/mover) com realce suave no hover -->
    <Border x:Name="Root" CornerRadius="20" Padding="6,3" BorderThickness="1"
            Background="{DynamicResource GlassCapsuleBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" Cursor="Hand"
            MouseEnter="Root_MouseEnter" MouseLeave="Root_MouseLeave"
            PreviewMouseLeftButtonDown="Root_PreviewMouseLeftButtonDown"
            MouseLeftButtonDown="Root_MouseLeftButtonDown"
            MouseMove="Root_MouseMove"
            MouseLeftButtonUp="Root_MouseLeftButtonUp"
            ContextMenuOpening="Root_ContextMenuOpening">

        <Border.ContextMenu>
            <ContextMenu Closed="ContextMenu_Closed">
                <MenuItem x:Name="MoveMenu" Header="Mover widget" IsCheckable="True" Click="MoveMode_Click"
                          ToolTip="Arrasta o widget para onde quiseres; desmarca para bloquear nessa posição"/>
                <MenuItem x:Name="ResetPosMenu" Header="Repor posição automática" Click="ResetPos_Click"/>
                <MenuItem x:Name="MonitorMenu" Header="Monitor"/>
                <MenuItem x:Name="SizeMenuItem" Header="Tamanho">
                    <MenuItem x:Name="SizeSmall" Header="Pequeno" IsCheckable="True" Click="Size_Click" Tag="0.8"/>
                    <MenuItem x:Name="SizeNormal" Header="Normal" IsCheckable="True" Click="Size_Click" Tag="1.0"/>
                    <MenuItem x:Name="SizeLarge" Header="Grande" IsCheckable="True" Click="Size_Click" Tag="1.1"/>
                </MenuItem>
                <MenuItem x:Name="OpacityMenuItem" Header="Brilho" StaysOpenOnClick="True">
                    <!-- Slider contínuo (pedido da comunidade OLED); mínimo de 20%
                         para o widget nunca ficar invisível e inalcançável -->
                    <MenuItem x:Name="OpacitySliderItem" StaysOpenOnClick="True">
                        <MenuItem.Header>
                            <StackPanel Orientation="Horizontal">
                                <Slider x:Name="OpacitySlider" Style="{StaticResource SpotifySlider}" Width="110"
                                        Minimum="20" Maximum="100" SmallChange="5" LargeChange="10"
                                        IsMoveToPointEnabled="True" VerticalAlignment="Center"
                                        ValueChanged="OpacitySlider_ValueChanged"
                                        MouseWheel="Opacity_MouseWheel"/>
                                <TextBlock x:Name="OpacityValueText" Text="100%" Foreground="{DynamicResource PrimaryBrush}"
                                           Margin="8,0,0,0" Width="36" VerticalAlignment="Center"/>
                            </StackPanel>
                        </MenuItem.Header>
                    </MenuItem>
                </MenuItem>
                <MenuItem x:Name="ButtonsMenuItem" Header="Botões">
                    <MenuItem x:Name="BtnPlayMenu" Header="Reproduzir/Pausar" IsCheckable="True" Click="Buttons_Click"/>
                    <MenuItem x:Name="BtnLikeMenu" Header="Adicionar aos favoritos (+)" IsCheckable="True" Click="Buttons_Click"/>
                    <MenuItem x:Name="BtnShuffleMenu" Header="Modo aleatório" IsCheckable="True" Click="Buttons_Click"/>
                    <MenuItem x:Name="BtnPrevMenu" Header="Anterior" IsCheckable="True" Click="Buttons_Click"/>
                    <MenuItem x:Name="BtnNextMenu" Header="Seguinte" IsCheckable="True" Click="Buttons_Click"/>
                    <MenuItem x:Name="BtnRepeatMenu" Header="Repetição" IsCheckable="True" Click="Buttons_Click"/>
                    <MenuItem x:Name="BtnVolumeMenu" Header="Volume" IsCheckable="True" Click="Buttons_Click"/>
                </MenuItem>
                <MenuItem x:Name="ProgressMenu" Header="Barra de progresso" IsCheckable="True" Click="Progress_MenuClick"/>
                <MenuItem x:Name="ScrollOnceMenu" Header="Deslizar título só uma vez" IsCheckable="True" Click="ScrollOnce_Click"/>
                <MenuItem x:Name="LauncherMenu" Header="Mostrar botão para abrir o Spotify" IsCheckable="True"
                          Click="Launcher_Click"
                          ToolTip="Com o Spotify fechado, mostra um botão para o abrir em vez de esconder o widget"/>
                <Separator/>
                <MenuItem x:Name="AutoStartMenu" Header="Iniciar com o Windows" IsCheckable="True" Click="AutoStart_Click"/>
                <MenuItem x:Name="OpenSpotifyMenu" Header="Abrir Spotify" Click="OpenSpotify_Click"/>
                <MenuItem x:Name="DonateMenu" Header="Apoiar o projeto ☕" Click="Donate_Click" Visibility="Collapsed"/>
                <MenuItem x:Name="UpdateMenu" Header="Procurar atualizações" Click="Update_Click"/>
                <Separator/>
                <MenuItem x:Name="ExitMenu" Header="Sair" Click="Exit_Click"/>
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Border Background="{DynamicResource GlassReflectionBrush}" CornerRadius="19" Margin="-5,-2" IsHitTestVisible="False"/>
            <Border x:Name="GlassHover" Background="{DynamicResource GlassHoverBrush}" CornerRadius="19" Margin="-5,-2" Opacity="0" IsHitTestVisible="False"/>

            <!-- Spotify fechado: botão opcional para o abrir -->
            <StackPanel x:Name="LauncherPanel" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center"
                        Visibility="Collapsed" ToolTip="Abrir o Spotify">
                <Path Width="20" Height="20" Stretch="Uniform" Fill="#1ED760" VerticalAlignment="Center"
                      Data="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zm3.669 11.538a.498.498 0 0 1-.686.165c-1.879-1.147-4.243-1.407-7.028-.77a.499.499 0 0 1-.222-.973c3.048-.696 5.662-.397 7.77.892a.5.5 0 0 1 .166.686zm.979-2.178a.624.624 0 0 1-.858.205c-2.15-1.321-5.428-1.704-7.972-.932a.625.625 0 0 1-.362-1.194c2.905-.881 6.517-.454 8.986 1.063a.624.624 0 0 1 .206.858zm.084-2.268C10.154 5.56 5.9 5.419 3.438 6.166a.748.748 0 1 1-.434-1.432c2.825-.857 7.523-.692 10.492 1.07a.747.747 0 1 1-.764 1.288z"/>
                <TextBlock x:Name="LauncherText" Text="Abrir Spotify" Foreground="{DynamicResource SecondaryBrush}"
                           FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="12" FontWeight="SemiBold"
                           Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>

            <StackPanel x:Name="ContentPanel" Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">

                <!-- Capa do álbum estilo Windows 11 com cantos arredondados e borda sutil -->
                <Button x:Name="ArtworkDetailsButton" Style="{StaticResource IconButton}" Width="32" Height="32"
                        Click="Details_Click" ToolTip="Show controls">
                <Border x:Name="ArtFrame" Width="32" Height="32" CornerRadius="10" Background="{DynamicResource ArtSurfaceBrush}" VerticalAlignment="Center"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        ClipToBounds="True" BorderBrush="{DynamicResource ArtBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Path x:Name="ArtPlaceholder" Width="16" Height="16" Stretch="Uniform"
                              Fill="{DynamicResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M6,3 L15,1 L15,12 C15,15 10,16 10,13 C10,11 12,10 13.5,10.5 L13.5,4 L7.5,5.4 L7.5,13 C7.5,16 2.5,17 2.5,14 C2.5,12 4.5,11 6,11.5 Z"/>
                        <Border x:Name="ArtImage" CornerRadius="9" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrush" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                        <!-- Camada de cima: a nova capa esbate para dentro por
                             cima da atual (crossfade), depois passa a ser a base -->
                        <Border x:Name="ArtImageTop" CornerRadius="9" Opacity="0" Visibility="Collapsed">
                            <Border.Background>
                                <ImageBrush x:Name="ArtBrushTop" Stretch="UniformToFill"/>
                            </Border.Background>
                        </Border>
                    </Grid>
                </Border>

                </Button>

                <!-- Título e artista estilo Windows 11 Fluent -->
                <StackPanel x:Name="TextStack" VerticalAlignment="Center" Margin="9,0,3,0" Width="150">
                    <!-- Canvas: mede o filho com espaço infinito, por isso o título
                         renderiza SEMPRE completo (a Grid cortava-o à largura da
                         célula e o marquee deslizava um texto já truncado) -->
                    <Canvas x:Name="TitleClip" ClipToBounds="True" Height="17">
                        <TextBlock x:Name="TitleText" Text="Spotify" Foreground="{DynamicResource PrimaryBrush}"
                                   FontFamily="Segoe UI Variable Text, Segoe UI"
                                   FontWeight="SemiBold" FontSize="12.5"
                                   Canvas.Left="0" Canvas.Top="0">
                            <TextBlock.RenderTransform>
                                <TranslateTransform x:Name="TitleShift"/>
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Canvas>
                    <TextBlock x:Name="ArtistText" Text="nada a tocar" Foreground="{DynamicResource SecondaryBrush}"
                               FontFamily="Segoe UI Variable Text, Segoe UI"
                               FontSize="11" TextTrimming="CharacterEllipsis" Margin="0,1,0,0"/>
                </StackPanel>
                <!-- Compact transport; secondary controls are in ExpandedPopup. -->

                <Button x:Name="PlayPauseButton" Style="{StaticResource PlayButton}"
                        Margin="2,0" VerticalAlignment="Center" Click="PlayPause_Click" ToolTip="Reproduzir/Pausar">
                    <Path x:Name="PlayPauseIcon" Width="12" Height="12" Stretch="Uniform" Fill="{DynamicResource GlassPlayInkBrush}"
                          Margin="1.5,0,0,0"
                          Data="M3 1.713a.7.7 0 0 1 1.05-.607l10.89 6.288a.7.7 0 0 1 0 1.212L4.05 14.894A.7.7 0 0 1 3 14.288V1.713z"/>
                </Button>
                <Button x:Name="NextButton" Style="{StaticResource IconButton}"
                        Margin="2,0,0,0" VerticalAlignment="Center" Click="Next_Click" ToolTip="Seguinte">
                    <Path x:Name="NextIcon" Width="13" Height="13" Stretch="Uniform" Fill="{DynamicResource SecondaryBrush}"
                          Data="M12.7 1a.7.7 0 0 0-.7.7v5.15L2.05 1.106A.7.7 0 0 0 1 1.712v12.575a.7.7 0 0 0 1.05.607L12 9.149V13.3a.7.7 0 0 0 .7.7h1.6a.7.7 0 0 0 .7-.7V1.7a.7.7 0 0 0-.7-.7h-1.6z"/>
                </Button>
                <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Margin="2,0,0,0" Click="Details_Click"
                        ToolTip="Show controls" VerticalAlignment="Center">
                    <Path Width="14" Height="4" Stretch="Uniform" Fill="{DynamicResource SecondaryBrush}"
                          Data="M0,2 A2,2 0 1 0 4,2 A2,2 0 1 0 0,2 M6,2 A2,2 0 1 0 10,2 A2,2 0 1 0 6,2 M12,2 A2,2 0 1 0 16,2 A2,2 0 1 0 12,2"/>
                </Button>

            </StackPanel>


            <Popup x:Name="ExpandedPopup" PlacementTarget="{Binding ElementName=Root}" Placement="Top" VerticalOffset="-8"
                   AllowsTransparency="True" Focusable="False" StaysOpen="False" PopupAnimation="None"
                   Opened="ExpandedPopup_Opened" Closed="ExpandedPopup_Closed">
                <Border x:Name="ExpandedSurface" Width="316" CornerRadius="22" Padding="16" Margin="6"
                        Background="{DynamicResource GlassPanelBrush}" BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
                        PreviewKeyDown="ExpandedSurface_PreviewKeyDown">
                    <Grid>
                        <Border Background="{DynamicResource GlassReflectionBrush}" CornerRadius="21" Margin="-15" IsHitTestVisible="False"/>
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="56"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions>
                                <Rectangle Width="56" Height="56" RadiusX="15" RadiusY="15" RenderOptions.BitmapScalingMode="HighQuality">
                                    <Rectangle.Fill><VisualBrush Visual="{Binding ElementName=ArtFrame}" Stretch="UniformToFill"/></Rectangle.Fill>
                                </Rectangle>
                                <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="NowPlayingLabel" Text="NOW PLAYING" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource SecondaryBrush}" Margin="0,0,0,4"/>
                                    <TextBlock x:Name="ExpandedTitle" Text="{Binding Text, ElementName=TitleText}" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Text, ElementName=ArtistText}" FontSize="11" Foreground="{DynamicResource SecondaryBrush}" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
                                </StackPanel>
                                <Button x:Name="CloseDetailsButton" Grid.Column="2" Width="22" Height="22" Style="{StaticResource IconButton}" VerticalAlignment="Top" Click="CloseDetails_Click" ToolTip="Close controls">
                                    <Path Width="9" Height="9" Data="M0,0 L9,9 M9,0 L0,9" Stroke="{DynamicResource SecondaryBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                </Button>
                            </Grid>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <Button x:Name="ShuffleButton" Style="{StaticResource IconButton}"
                        Margin="4,0" VerticalAlignment="Center" Click="Shuffle_Click"
                        ToolTip="Modo aleatório">
                    <Grid Width="20" Height="20">
                        <Path x:Name="ShuffleIcon" Width="14" Height="14" Stretch="Uniform" Fill="{DynamicResource SecondaryBrush}"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Data="M13.151.922a.75.75 0 1 0-1.06 1.06L13.109 3H11.16a3.75 3.75 0 0 0-2.873 1.34l-6.173 7.356a2.25 2.25 0 0 1-1.724.804H0v1.5h.391a3.75 3.75 0 0 0 2.873-1.34l6.173-7.356a2.25 2.25 0 0 1 1.724-.804h1.947l-1.017 1.018a.75.75 0 0 0 1.06 1.06L15.98 3.75 13.151.922zM.391 3.5H0V2h.391c1.109 0 2.16.49 2.873 1.34L4.89 5.277l-.979 1.167-1.796-2.14A2.25 2.25 0 0 0 .391 3.5zm7.5 7.223.98-1.167.957 1.14a2.25 2.25 0 0 0 1.724.804h1.947l-1.017-1.018a.75.75 0 1 1 1.06-1.06l2.829 2.828-2.829 2.828a.75.75 0 1 1-1.06-1.06L13.109 13H11.16a3.75 3.75 0 0 1-2.873-1.34l-.896-1.067z"/>
                        <Path x:Name="ShuffleSmartStar" Width="7" Height="7" Stretch="Uniform" Fill="#1ED760"
                              HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-1,-1,0"
