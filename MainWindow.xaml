                </Button>
                                <Button x:Name="OpenPlayerButton" Grid.Column="1" Style="{StaticResource IconButton}" Width="Auto" Padding="10,0" HorizontalAlignment="Center" Click="OpenSelectedPlayer_Click" ToolTip="Open Spotify">
                                    <TextBlock x:Name="OpenPlayerLabel" Text="Spotify" FontSize="10" Foreground="{DynamicResource SecondaryBrush}" Margin="12,0"/>
                                </Button>
