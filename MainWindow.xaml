                            <Border x:Name="ProgressTrack" Height="14" Background="Transparent" Margin="0,10,0,0" Cursor="Hand"
                    MouseLeftButtonDown="Progress_MouseLeftButtonDown"
                    MouseEnter="Progress_MouseEnter" MouseLeave="Progress_MouseLeave">
                <Border Height="3" CornerRadius="1.5" Background="{DynamicResource ProgressTrackBrush}" VerticalAlignment="Center">
                    <Border x:Name="ProgressFill" CornerRadius="1.5" Background="{DynamicResource PrimaryBrush}" HorizontalAlignment="Left" Width="0"/>
                </Border>
            </Border>
                            <Grid x:Name="TimelineLabels" Margin="0,0,0,0">
                                <TextBlock x:Name="PositionText" Text="0:00" FontSize="9" Foreground="{DynamicResource SecondaryBrush}"/>
                                <TextBlock x:Name="DurationText" Text="0:00" FontSize="9" Foreground="{DynamicResource SecondaryBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                            <Border Height="1" Background="{DynamicResource GlassSoftEdgeBrush}" Margin="0,12,0,8"/>
