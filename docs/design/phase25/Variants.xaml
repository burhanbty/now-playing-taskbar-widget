<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Loose WPF design studies. No raster mockups, native backdrops or media access. -->
    <ControlTemplate x:Key="Tidal" TargetType="ContentControl">
        <Border CornerRadius="21" Background="{DynamicResource GlassCapsuleBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Padding="5,3">
            <Grid>
                <Border Background="{DynamicResource GlassReflectionBrush}" CornerRadius="18" IsHitTestVisible="False"/>
                <StackPanel Orientation="Horizontal">
                    <Border Width="32" Height="32" CornerRadius="11" Background="#156A83">
                        <Ellipse Width="19" Height="19" Fill="#ABDCE8"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Width="133" Margin="10,0,12,0">
                        <TextBlock Text="Midnight current" FontFamily="Segoe UI Variable Text" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Astra · Ocean drive" FontFamily="Segoe UI Variable Text" FontSize="10.5" Foreground="{DynamicResource SecondaryBrush}"/>
                    </StackPanel>
                    <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource GlassPlayBrush}">
                        <Path Width="9" Height="11" Data="M0,0 L9,5.5 L0,11Z" Stretch="Fill" Fill="{DynamicResource GlassPlayInkBrush}" Margin="2,0,0,0"/>
                    </Border>
                    <Path Width="12" Height="12" Margin="13,0" Stretch="Uniform" Fill="{DynamicResource PrimaryBrush}" Data="M0,0 L9,6 L0,12Z M10,0 H12 V12 H10Z"/>
                    <TextBlock Text="···" Width="23" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Border>
    </ControlTemplate>
    <ControlTemplate x:Key="Prism" TargetType="ContentControl">
        <StackPanel Orientation="Horizontal">
            <Border Width="40" Height="40" CornerRadius="14" Background="#156A83"
                    BorderThickness="1" BorderBrush="{DynamicResource GlassEdgeBrush}">
                <Ellipse Width="24" Height="24" Fill="#ABDCE8"/>
            </Border>
            <Border Margin="5,0,0,0" Padding="12,4,5,4" CornerRadius="15"
                    BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" Background="{DynamicResource GlassCapsuleBrush}">
                <StackPanel Orientation="Horizontal">
                    <StackPanel Width="138" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Midnight current" FontFamily="Segoe UI Variable Text" FontWeight="SemiBold" FontSize="12" Foreground="{DynamicResource PrimaryBrush}"/>
                        <TextBlock Text="Astra · Ocean drive" FontFamily="Segoe UI Variable Text" FontSize="10.5" Foreground="{DynamicResource SecondaryBrush}"/>
                    </StackPanel>
                    <Border Width="46" Height="28" CornerRadius="10" Background="{DynamicResource GlassInsetBrush}" BorderBrush="{DynamicResource GlassSoftEdgeBrush}" BorderThickness="1">
                        <Path Width="9" Height="11" Data="M0,0 L9,5.5 L0,11Z" Stretch="Fill" Fill="{DynamicResource PrimaryBrush}"/>
                    </Border>
                    <TextBlock Text="···" Width="24" Margin="8,0,0,0" FontSize="20" VerticalAlignment="Center" Foreground="{DynamicResource SecondaryBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ControlTemplate>
</ResourceDictionary>
